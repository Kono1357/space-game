        }
       ]
      },
      "report": {
       "text": "星图上多了一个点。不发光，但把旁边的光都吃掉了。",
       "options": [
        {
         "text": "记下来。",
         "goto": "end"
        }
       ]
      },
      "end": {
       "text": "我盯着呢。",
       "action": "close_dialogue"
      }
     }
    }
   ]
  },
  "views": {
