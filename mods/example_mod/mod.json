{
 "id": "example_mod",
 "name": "观景台（示例 mod）",
 "version": "1.0.0",
 "priority": 10,
 "author": "框架自带",
 "description": "演示如何在纯 JSON 下加场景、加人、加对话、加终端，并且用 _append 给已有场景开一扇门。",
 "defaultOp": "append",
