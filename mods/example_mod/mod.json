     "name": "观景台",
     "type": "space_station",
     "size": {
      "w": 30,
      "h": 12
     },
     "tiles": [
      "██████████████████████████████",
      "█............................█",
      "█...........O.....O..........█",
      "█......X.....................█",
      "█............................█",
      "█............................█",
      "█............................+",
      "█............................█",
      "█............................█",
      "█..◆.........................█",
      "█............................█",
      "██████████████████████████████"
     ],
     "legend": {
      "█": {
       "preset": "wall"
      },
      ".": {
       "preset": "floor"
      },
      "+": {
       "preset": "door"
      },
      "X": {
       "interactable": "mod_telescope"
      },
      "◆": {
       "interactable": "save_point"
      },
      "O": {
       "interactable": "mod_window"
      }
     },
     "exits": [
      {
       "x": 29,
       "y": 6,
       "to": "station_corridor",
       "at": {
        "x": 2,
        "y": 6
       },
       "direction": "east"
      }
     ],
     "ambient": "观景台没有灯。只有一层薄薄的黑，和外面真正的黑。",
     "lit": true
    },
    {
     "id": "station_corridor",
     "_op": "patch",
     "_append": {
      "tileEdits": [
       {
        "x": 0,
        "y": 6,
        "preset": "door"
       }
      ],
      "exits": [
       {
        "x": 0,
        "y": 6,
        "to": "mod_observatory",
        "at": {
         "x": 22,
         "y": 5
        },
        "direction": "west"
       }
      ]
     }
    }
   ]
  },
  "interactables": {
   "list": [
    {
     "id": "mod_telescope",
