{
 "id": "starter_mod",
 "name": "起手 mod（照着改就行）",
 "version": "1.0.0",
 "priority": 100,
 "description": "一个能跑的最小 mod：新房间 + 一扇用 _append 开出来的门 + 终端 + 人 + 对话 + 终端界面 + 宏 + 钩子 + 自己起的块。",
 "_howToAdd": "改 id / name / 房间名就是你的 mod。每行 tiles 长度必须等于 size.w；标准字符（# . + * h）不用写 legend，自己发明的字符（比如这里的 ?）才要写。",
 "data": {
  "scenes": {
   "_howToAdd": "第一条是新场景。第二条用 _op:patch + _append 给已有的环形走廊凿一扇门，不用重抄整张地图。",
   "list": [
    {
     "id": "my_room",
     "name": "我的房间",
     "type": "space_station",
     "size": {
      "w": 14,
      "h": 8
     },
     "tiles": [
      "##############",
      "#@...........#",
      "#....######..#",
      "#....#....#..+",
      "#....+....#?.#",
      "#....#....#..#",
      "#....######..#",
      "##############"
     ],
     "legend": {
      "?": {
       "interactable": "my_terminal"
      },
      "@": {
       "playerSpawn": true
      }
     },
     "exits": [
      {
       "x": 13,
       "y": 3,
       "to": "station_corridor",
       "at": {
        "x": 1,
        "y": 10
       },
       "direction": "east"
      }
     ],
     "ambient": "这是我加的房间。角落里那间小屋有一扇门，别把房间画成没门的盒子。",
     "lit": true
    },
    {
     "id": "station_corridor",
     "_op": "patch",
     "_append": {
      "tileEdits": [
       {
        "x": 0,
        "y": 10,
        "preset": "door"
       }
      ],
      "exits": [
       {
        "x": 0,
        "y": 10,
        "to": "my_room",
        "at": {
         "x": 12,
         "y": 3
        },
        "direction": "west"
       }
      ]
     }
    }
   ]
  },
  "interactables": {
   "_howToAdd": "symbol 必须单个字符（地图上就靠它认位置）。onInteract 是效果链，想要「走过去就自动开」就加 auto:true 并把 config.autoInteract 设 true。",
   "list": [
    {
     "id": "my_terminal",
     "name": "我的终端",
     "symbol": "?",
     "color": "accent",
     "bg": "panel2",
     "passable": false,
     "auto": false,
     "priority": 25,
     "onInteract": [
      {
       "type": "open_view",
       "view": "my_view"
      }
     ],
     "desc": "我自己加的终端。"
    }
   ]
  },
  "npcs": {
   "_howToAdd": "一个人 = npcs 一条 + schedules 一条；dialogue 指向下面那张节点图。",
   "list": [
    {
     "id": "npc_my_guest",
     "name": "我的客人",
     "symbol": "G",
     "color": "npc2",
     "role": "guest",
     "faction": "player_remnant",
     "homeScene": "my_room",
     "dialogue": "dialogue_my_guest"
    }
   ]
  },
  "schedules": {
   "_howToAdd": "slots[].hours 是时段（不写就全天）；坐标必须是可走的格子。",
   "list": [
    {
     "id": "sch_my_guest",
     "npcId": "npc_my_guest",
     "slots": [
      {
       "hours": [
        0,
        24
       ],
       "scene": "my_room",
       "x": 7,
       "y": 5
      }
     ]
    }
   ]
  },
  "dialogues": {
   "_howToAdd": "一张节点图：options[].goto 跳节点，action:close_dialogue 结束。effects 里能调宏。",
   "list": [
    {
     "id": "dialogue_my_guest",
     "npcId": "npc_my_guest",
     "entry": "root",
     "nodes": {
      "root": {
       "text": "这地方是你自己搭的？",
       "options": [
        {
         "text": "是我搭的。",
         "effects": [
          {
           "type": "macro",
           "id": "my_hello",
           "params": {
            "who": "客人"
           }
          }
         ],
         "goto": "done"
        },
        {
         "text": "才算搭了一半。",
         "effects": [
          {
           "type": "flag_set",
           "flag": "my_half_built"
          }
         ],
         "goto": "done"
        },
        {
         "text": "回头再说。",
         "goto": "end"
        }
       ]
      },
      "done": {
       "text": "看着还行。角落里那间小屋的门也是你凿的？",
       "options": [
        {
         "text": "嗯。",
         "goto": "end"
        }
       ]
      },
      "end": {
       "text": "行，我记住了。",
       "action": "close_dialogue"
      }
     }
    }
   ]
  },
  "views": {
   "_howToAdd": "终端界面：lines 是死文本；sections/list 可以 source 一个路径再套模板连你自己起的块也读得到。",
   "list": [
    {
     "id": "my_view",
     "title": "我的终端",
     "width": 62,
     "lines": [
      " 屏幕上只有两行字。",
      ""
     ],
     "sections": [
      {
       "title": " 我记的事 ",
       "source": "space.myNotes.list",
       "rowTemplate": " {row.text}",
       "empty": "（空）"
      }
     ],
     "actions": [
      {
       "text": "关闭",
       "effects": [
        {
         "type": "close_view"
        }
       ]
      }
     ]
    }
   ]
  },
  "macros": {
   "_howToAdd": "宏 = 内容层的函数：一串效果起个名字，别处一句 {\"type\":\"macro\",\"id\":\"名字\",\"params\":{...}} 复用，内部用 {args.键} 取参。还能带 condition 给判定词用。",
   "list": [
    {
     "id": "my_hello",
     "effects": [
      {
       "type": "log",
       "text": "{args.who}：你好。",
       "level": "good"
      },
      {
       "type": "counter_add",
       "counter": "my_hellos",
       "delta": 1
      }
     ]
    }
   ]
  },
  "hooks": {
   "_howToAdd": "钩子 = 不改引擎就挂在引擎已有的时刻上：game_start / tick / day / enter_scene / interact / npc_talk / dialogue_end / build_done。过滤器 scene/interactable/npcId/dialogue/buildId/event 写哪个就只在那时触发；effects 里放 {\"type\":\"stop\"} 能掐掉默认行为。",
   "list": [
    {
     "id": "hook_my_first",
     "on": "enter_scene",
     "scene": "my_room",
     "once": true,
     "effects": [
      {
       "type": "log",
       "text": "第一次走进自己的房间。",
       "level": "info"
      }
     ]
    },
    {
     "id": "hook_my_terminal",
     "on": "interact",
     "interactable": "my_terminal",
     "effects": [
      {
       "type": "log",
       "text": "（钩子）终端亮了一下。",
       "level": "dim"
      }
     ]
    }
   ]
  },
  "myNotes": {
   "_howToAdd": "这个块是我自己起的名字。内核不认内容，所以随便加；视图 source 到它也一样能读。",
   "list": [
    {
     "id": "note_1",
     "text": "门是 _append 凿出来的，没重抄整张走廊地图。"
    },
    {
     "id": "note_2",
     "text": "宏、钩子、自己起的块，全是 JSON，没有一行代码。"
    }
   ]
  }
 }
}